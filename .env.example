# ─── The Bridge — Variables d'environnement ────────────────────────────────────
# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne JAMAIS commiter le fichier .env dans Git.
# Ce fichier .env.example PEUT être commité — il ne contient aucun secret réel.
# ==============================================================================

# ─── BASE DE DONNÉES ──────────────────────────────────────────────────────────
# Local:  jdbc:mysql://localhost:3307/the_bridge?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# Render: fourni automatiquement par le service MySQL Render
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec: openssl rand -base64 64
JWT_SECRET=

# ─── MAIL (Gmail App Password) ────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── CLOUDINARY ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OAUTH2 — GOOGLE ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAUTH2 — FACEBOOK ────────────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4200/payment-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:4200/payment-fail

# ─── BLOCKCHAIN (Polygon Amoy Testnet) ────────────────────────────────────────
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_PRIVATE_KEY=

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Local:        laisser REDIS_URL vide, utiliser HOST/PORT
# Render/Cloud: renseigner REDIS_URL (ex: redis://user:pass@host:6379)
REDIS_URL=
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_10MIN=3
RATE_LIMIT_PASSWORD_RESET_PER_15MIN=3
RATE_LIMIT_EXPENSIVE_PER_MIN=10
RATE_LIMIT_AUTHENTICATED_PER_MIN=120

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local:      http://localhost:4200
# Production: https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ─── MONITORING & ACTUATOR BASIC AUTH ─────────────────────────────────────────
MONITORING_USERNAME=monitoring_admin
MONITORING_PASSWORD=

